<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sala de Escucha — Oyente</title>
  <style>
    /* ==========================================
       INTERFAZ DE MIEMBRO / OYENTE
       Diseño inmersivo tipo Spotify/Apple Music
    ========================================== */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --accent: #7c3aed;
      --accent2: #4f46e5;
    }

    html, body {
      height: 100%;
    }

    body {
      min-height: 100vh;
      background: #080810;
      color: #f0f0f8;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Fondo animado — gradientes que cambian según si hay música */
    #bg-gradient {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 30% 40%, rgba(88,28,135,0.25) 0%, transparent 60%),
        radial-gradient(ellipse at 70% 70%, rgba(30,58,175,0.2) 0%, transparent 60%);
      transition: opacity 1s;
      z-index: 0;
    }

    #bg-gradient.active {
      animation: bgPulse 4s ease-in-out infinite alternate;
    }

    @keyframes bgPulse {
      0%   { opacity: 0.7; filter: hue-rotate(0deg); }
      100% { opacity: 1;   filter: hue-rotate(20deg); }
    }

    /* Contenedor principal */
    .container {
      position: relative;
      z-index: 1;
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      text-align: center;
    }

    /* --- COVER ART ANIMADO --- */
    .cover-art {
      position: relative;
      margin-bottom: 2.5rem;
    }

    .cover-circle {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 50%, #1d4ed8 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
      box-shadow:
        0 0 60px rgba(124,58,237,0.4),
        0 0 120px rgba(124,58,237,0.15);
      transition: transform 0.5s;
    }

    .cover-circle.playing {
      animation: spin 12s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    /* Anillo exterior pulsante (cuando está sonando) */
    .cover-ring {
      position: absolute;
      inset: -12px;
      border-radius: 50%;
      border: 2px solid rgba(124,58,237,0.3);
      opacity: 0;
      transition: opacity 0.5s;
    }

    .cover-ring.visible {
      opacity: 1;
      animation: ringPulse 2s ease-in-out infinite;
    }

    @keyframes ringPulse {
      0%, 100% { transform: scale(1);    opacity: 0.4; }
      50%       { transform: scale(1.05); opacity: 0.8; }
    }

    /* --- INFORMACIÓN DE LA CANCIÓN --- */
    .song-info {
      max-width: 500px;
    }

    #song-name {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      line-height: 1.15;
      color: #f5f5ff;
      margin-bottom: 0.5rem;
      transition: all 0.4s;
    }

    #song-artist {
      font-size: 1.15rem;
      color: rgba(180,180,220,0.7);
      font-weight: 500;
      margin-bottom: 1.5rem;
    }

    /* Badge "Escuchando en vivo" */
    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(124,58,237,0.2);
      border: 1px solid rgba(124,58,237,0.35);
      color: #a78bfa;
      padding: 0.4rem 1rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 1.5rem;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #a78bfa;
    }

    .live-dot.pulsing {
      animation: dotPulse 1.5s ease-in-out infinite;
    }

    @keyframes dotPulse {
      0%, 100% { background: #a78bfa; box-shadow: 0 0 0 0 rgba(167,139,250,0.5); }
      50%       { background: #c4b5fd; box-shadow: 0 0 0 5px rgba(167,139,250,0); }
    }

    /* --- REPRODUCTOR DE AUDIO (oculto visualmente, funcional) --- */
    #audio-player {
      width: 100%;
      max-width: 400px;
      margin-bottom: 1rem;
      accent-color: var(--accent);
      border-radius: 8px;
    }

    /* URL de la canción */
    #song-url-area {
      max-width: 420px;
      margin-top: 0.5rem;
    }

    .url-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(120,120,160,0.5);
      margin-bottom: 0.3rem;
    }

    #song-url {
      font-size: 0.75rem;
      color: rgba(140,140,200,0.6);
      word-break: break-all;
      font-family: monospace;
    }

    /* Estado: esperando canción */
    .waiting-state {
      color: rgba(120,120,160,0.6);
      font-size: 0.9rem;
      margin-top: 1rem;
    }

    /* --- HEADER MINIMALISTA --- */
    .top-bar {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .top-brand {
      font-size: 0.9rem;
      color: rgba(180,180,220,0.5);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .user-info {
      font-size: 0.8rem;
      color: rgba(120,120,160,0.6);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    a.logout-link {
      color: rgba(120,120,160,0.5);
      text-decoration: none;
      font-size: 0.75rem;
      border: 1px solid rgba(255,255,255,0.06);
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      transition: all 0.2s;
    }

    a.logout-link:hover {
      color: rgba(180,180,220,0.7);
      border-color: rgba(124,58,237,0.3);
    }
  </style>
</head>
<body>

  <!-- Fondo animado -->
  <div id="bg-gradient"></div>

  <!-- Barra superior -->
  <div class="top-bar">
    <div class="top-brand">🎵 Sala de Escucha</div>
    <div class="user-info">
      <%= username %>
      <a href="/logout" class="logout-link">Salir</a>
    </div>
  </div>

  <!-- Área central del oyente -->
  <div class="container">

    <!-- Cover art animado -->
    <div class="cover-art">
      <div class="cover-ring" id="cover-ring"></div>
      <div class="cover-circle" id="cover-circle">🎵</div>
    </div>

    <!-- Info de la canción -->
    <div class="song-info">

      <div class="live-badge">
        <div class="live-dot" id="live-dot"></div>
        Escuchando en vivo...
      </div>

      <div id="song-name">Esperando canción...</div>
      <div id="song-artist"></div>

      <!-- Reproductor de audio controlado por el servidor -->
      <audio id="audio-player" controls>
        Tu navegador no soporta el elemento audio.
      </audio>

      <!-- URL de la canción visible para el miembro -->
      <div id="song-url-area" style="display:none">
        <div class="url-label">Fuente de audio</div>
        <div id="song-url"></div>
      </div>

    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>

  <script>
    // =============================================
    // JAVASCRIPT DEL MIEMBRO / OYENTE
    // Sincroniza el audio con las órdenes del servidor
    // =============================================

    const audio      = document.getElementById('audio-player');
    const songNameEl = document.getElementById('song-name');
    const artistEl   = document.getElementById('song-artist');
    const songUrlEl  = document.getElementById('song-url');
    const urlArea    = document.getElementById('song-url-area');
    const bgGrad     = document.getElementById('bg-gradient');
    const circle     = document.getElementById('cover-circle');
    const ring       = document.getElementById('cover-ring');
    const liveDot    = document.getElementById('live-dot');

    // Conectar al servidor Socket.IO
    const socket = io();

    // -----------------------------------------------
    // Recibir el estado inicial al conectarse
    // -----------------------------------------------
    socket.on('sync:state', (state) => {
      if (state.url) {
        loadSong(state.url, state.name, state.artist);

        // Calcular el tiempo real ajustado por latencia de red
        const networkDelayMs = Date.now() - (state.serverTime || Date.now());
        let adjustedTime = state.currentTime + (networkDelayMs / 1000);
        if (adjustedTime < 0) adjustedTime = 0;

        audio.currentTime = adjustedTime;

        if (state.isPlaying) {
          audio.play().catch(() => {
            // El navegador puede bloquear el autoplay hasta que el usuario interactúe
            console.log('Autoplay bloqueado. Se activará cuando el usuario interactúe.');
          });
          setPlayingState(true);
        }
      }
    });

    // -----------------------------------------------
    // Recibir orden de PLAY desde el admin
    // -----------------------------------------------
    socket.on('sync:play', (data) => {
      // Calcular el tiempo ajustado por latencia de red
      const networkDelayMs = Date.now() - (data.serverTime || Date.now());
      let adjustedTime = data.currentTime + (networkDelayMs / 1000);
      if (adjustedTime < 0) adjustedTime = 0;

      // Solo ajustar si la diferencia es mayor a 1 segundo
      if (Math.abs(audio.currentTime - adjustedTime) > 1) {
        audio.currentTime = adjustedTime;
      }

      audio.play().catch((err) => {
        console.error('No se pudo reproducir:', err);
      });

      setPlayingState(true);
    });

    // -----------------------------------------------
    // Recibir orden de PAUSE desde el admin
    // -----------------------------------------------
    socket.on('sync:pause', (data) => {
      audio.pause();

      // Sincronizar el tiempo exacto
      if (Math.abs(audio.currentTime - data.currentTime) > 0.5) {
        audio.currentTime = data.currentTime;
      }

      setPlayingState(false);
    });

    // -----------------------------------------------
    // Recibir NUEVA CANCIÓN desde el admin
    // -----------------------------------------------
    socket.on('sync:changeSong', (data) => {
      audio.pause();
      loadSong(data.url, data.name, data.artist);
      audio.currentTime = 0;
      setPlayingState(false);
    });

    // -----------------------------------------------
    // Cargar una canción en el reproductor
    // -----------------------------------------------
    function loadSong(url, name, artist) {
      audio.src = url;
      songNameEl.textContent   = name   || 'Sin título';
      artistEl.textContent     = artist || '';
      songUrlEl.textContent    = url;
      urlArea.style.display    = 'block';
    }

    // -----------------------------------------------
    // Cambiar el estado visual (tocando / en pausa)
    // -----------------------------------------------
    function setPlayingState(isPlaying) {
      if (isPlaying) {
        circle.classList.add('playing');
        ring.classList.add('visible');
        bgGrad.classList.add('active');
        liveDot.classList.add('pulsing');
      } else {
        circle.classList.remove('playing');
        ring.classList.remove('visible');
        bgGrad.classList.remove('active');
        liveDot.classList.remove('pulsing');
      }
    }

    // -----------------------------------------------
    // Sincronización periódica (corrección de deriva)
    // El evento 'timeupdate' se dispara mientras suena el audio
    // Aquí podríamos ajustar si el tiempo se desvía mucho,
    // pero con Socket.IO y la lógica de arriba es suficiente
    // -----------------------------------------------
    audio.addEventListener('timeupdate', () => {
      // Espacio para lógica adicional de corrección de deriva
    });
  </script>

</body>
</html>
